# --- Required ---
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-letter-gmail-app-password
GEMINI_API_KEY=your-gemini-key

# --- Admin dashboard (/admin) ---
ADMIN_USERNAME=admin
# Generate with: flask --app app hash-password   (keep the single quotes)
ADMIN_PASSWORD_HASH='paste-the-hash-here'
# Times in the dashboard are shown in this timezone (IANA name, e.g. Africa/Johannesburg)
DISPLAY_TIMEZONE=UTC

# --- Optional contact features (leave empty to switch off) ---
# Floating WhatsApp button + link on the contact page; international format
WHATSAPP_NUMBER=
# Calendly / Cal.com link for every "Book a Free Consultation" button (defaults to /contact)
BOOKING_URL=
# Cloudflare Turnstile spam check (free): https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Send visitors an automatic "we've received your message" email (1/0)
AUTO_REPLY=1

# Local development over plain http only: set to 0 so the admin login cookie works
# SESSION_COOKIE_SECURE=0
